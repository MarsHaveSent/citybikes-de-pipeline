# Сертификат для домена Caddy получает и продлевает сам
{
	# На этот адрес Let's Encrypt пишет, если с сертификатом что-то не так
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	redir /airflow /airflow/
	handle /airflow/* {
		reverse_proxy airflow-apiserver:8080
	}

	handle {
		reverse_proxy metabase:3000
	}
}
