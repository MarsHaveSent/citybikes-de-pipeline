# Сертификат для домена Caddy получает и продлевает сам
{
	# С email Caddy при отказе Let's Encrypt берёт сертификат у ZeroSSL: у поддоменов хостера
	# общий лимит Let's Encrypt (50 сертификатов в неделю на домен второго уровня), и он выбирается
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	redir /airflow /airflow/
	handle /airflow/* {
		reverse_proxy airflow-apiserver:8080
	}

	handle {
		respond "CityBikes pipeline" 200
	}
}
