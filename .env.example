# Пустые значения заполняет scripts/init_env.py

# Postgres: суперпользователь кластера
POSTGRES_PASSWORD=
# 5432–5434 на хосте часто заняты локальными Postgres и SSH-туннелями
POSTGRES_HOST_PORT=15432

# Пользователи БД airflow (метаданные Airflow) и citybikes (источник данных)
AIRFLOW_DB_PASSWORD=
CITYBIKES_DB_PASSWORD=

# Airflow
AIRFLOW_FERNET_KEY=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=

# ClickHouse: пользователь citybikes, под ним загружаются витрины
CLICKHOUSE_PASSWORD=

# Алерты на почту по SMTP с SSL. Заполняются вручную, пустые значения - алерты только в логах.
# Mail.ru и Яндекс принимают по SMTP не пароль от ящика, а пароль для внешних приложений
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
