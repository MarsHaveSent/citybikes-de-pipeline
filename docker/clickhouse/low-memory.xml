<!-- Сокращённая конфигурация ClickHouse для работы в контейнере с ограниченной памятью.-->
<clickhouse>
    <max_server_memory_usage>1610612736</max_server_memory_usage>
    <mark_cache_size>268435456</mark_cache_size>
    <index_mark_cache_size>67108864</index_mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>

    <!-- query_log хранится 3 дня;-->
    <query_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </query_log>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <text_log remove="1"/>
    <part_log remove="1"/>
    <processors_profile_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
</clickhouse>
