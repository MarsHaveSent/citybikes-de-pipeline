<!-- Пользователь Metabase: только чтение базы citybikes-->
<clickhouse>
    <profiles>
        <bi>
            <!-- 2 - только чтение, но с правом менять настройки запроса: драйвер Metabase их выставляет -->
            <readonly>2</readonly>
            <max_execution_time>60</max_execution_time>
            <max_memory_usage>1073741824</max_memory_usage>
        </bi>
    </profiles>
    <users>
        <metabase>
            <password from_env="CLICKHOUSE_METABASE_PASSWORD"/>
            <profile>bi</profile>
            <quota>default</quota>
            <networks>
                <ip>::/0</ip>
            </networks>
            <grants>
                <query>GRANT SELECT ON citybikes.*</query>
            </grants>
        </metabase>
    </users>
</clickhouse>
